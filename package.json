{
  "name": "touch-in-stakk",
  "productName": "Touch in STAKK",
  "version": "0.1.0",
  "private": true,
  "description": "Launcher desktop pour Dofus Touch",
  "author": "STAKK",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.stakk.touchinstakk",
    "productName": "Touch in STAKK",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "stakk.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vDAKK",
        "repo": "touch-in-stakk-releases"
      }
    ],
    "win": {
      "icon": "stakk.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Touch-in-STAKK-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Touch-in-STAKK-portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Touch-in-STAKK-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Touch in STAKK ${version}"
    }
  }
}
